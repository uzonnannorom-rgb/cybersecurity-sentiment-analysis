# Copy this file, rename the copy to .env, and fill in your own values.
# Never upload .env to GitHub.

REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=CyberStreamCoursework/1.0

# Optional: folder where CSV files are saved (defaults to ./data)
CYBER_PROJECT_DIR=

# Optional: MongoDB connection (defaults to a local MongoDB)
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=cyber_stream
